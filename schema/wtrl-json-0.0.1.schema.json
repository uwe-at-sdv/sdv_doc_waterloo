{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtrl-export-0.0.1.schema.json",
  "title": "Waterloo JSON export (schema 0.0.1, provisional)",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "__WTRL_VERSION__",
    "__WTRL_META__",
    "__WTRL_ROLES__",
    "__WTRL_OBJECTS__"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string" },
    "$id": {"type": "string" },
    "__WTRL_VERSION__": {
      "type": "object",
      "required": ["waterloo", "schema"],
      "additionalProperties": false,
      "properties": {
        "waterloo": { "type": "string" },
        "schema": { "type": "string" }
	}
    },

    "__WTRL_META__":{
      "type": "object",
      "required": ["generated_at","generator","scope","flavour"],
      "additionalProperties": false,
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "generator": { "type": "string" },
	"scope": { "type": "string" },
	"flavour": { "type": "string" }
      }
    },

    "__WTRL_ROLES__": {
      "type": "object",
      "$comment": "Role entries look like e.g. 'attr':'Attribute name': label and human/LLM-readable explanation",
      "additionalProperties": { "type": "string" }
    },

    "__WTRL_TOC_MODULES__": { "$ref": "#/$defs/tocMap" },
    "__WTRL_TOC_CLASSES__": { "$ref": "#/$defs/tocMap" },
    "__WTRL_TOC_CALLABLES__": { "$ref": "#/$defs/tocMap" },
    "__WTRL_TOC_TYPES__": { "$ref": "#/$defs/tocMap" },
    "__WTRL_TOC_VARIABLES__": { "$ref": "#/$defs/tocMap" },
    "__WTRL_TOC_CONSTANTS__": { "$ref": "#/$defs/tocMap" },

    "__WTRL_OBJECTS__": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": { "$ref": "#/$defs/wtrlObject" }
    }
  },

  "$defs": {
    "jsonPointer": {
      "type": "string",
      "pattern": "^(#)?(/([^~]|~[01])*)*$"
    },

    "tocMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonPointer" }
    },

    "wtrlObject": {
      "type": "object",
      "required": ["doc"],
      "properties": {
        "path": {
		"$comment":"Built-in modules have no path, so null must be allowed:",
		"type": ["string","null"]
		},
        "signature": { "$ref": "#/$defs/signature" },
        "doc": {
	  "oneOf": [
	   {
	     "type": "object",
	     "minProperties": 0,
	     "additionalProperties": true
	   },
	   {
	     "type": "array",
	     "items": { "type": ["string", "number", "boolean", "null", "object", "array"] }
	   },
	   { "type": ["string", "null"] }
	  ]
        }
      },
      "additionalProperties": true
    },

    "signature": {
      "type": "object",
      "required": ["text", "parameters", "returns"],
      "properties": {
        "text": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "returns": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },

    "parameter": {
      "type": "object",
      "required": ["name", "kind", "annotation", "default"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "annotation": { "type": ["string", "null"] },
        "default": { "type": ["string", "number", "boolean", "null", "object", "array"] }
      },
      "additionalProperties": true
    }
  }
}
