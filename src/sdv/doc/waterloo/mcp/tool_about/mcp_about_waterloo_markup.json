{
  "topic": "waterloo.markup",
  "title": "Inline markup",
  "summary": "Normativity keywords, value tokens, roles, and examples.",
  "content": [
    {
      "kind": "normativity-keywords",
      "items": [
        "|Must|",
        "|Must_not|",
        "|must|",
        "|must_not|",
        "|Should|",
        "|Should_not|",
        "|should|",
        "|should_not|",
        "|May|",
        "|may|"
      ]
    },
    {
      "kind": "normativity-keyword-examples",
      "items": [
        "|Must| define the contract.",
        "The caller |must| supply an object.",
        "|Should| keep the helper small.",
        "The helper |should| stay flat.",
        "|May| be used for optional features.",
        "The caller |may| provide additional arguments.",
        "|Must_not| raise an exception."
      ]
    },
    {
      "kind": "value-tokens",
      "items": [
        "|None|",
        "|Self|",
        "|True|",
        "|False|"
      ]
    },
    {
      "kind": "value-token-examples",
      "items": [
        "Use |None| when a function does not return a value.",
        "Use |Self| for fluent interfaces that return the current instance.",
        "Use |True| and |False| for boolean outcomes or normative clauses."
      ]
    },
    {
      "kind": "roles",
      "items": [
        "attr",
        "cmd",
        "dfn",
        "file",
        "func",
        "key",
        "label",
