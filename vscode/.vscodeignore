# Exclude development and packaging artifacts
*.vsix
*.pyc
__pycache__/
.mypy_cache/

# Local helper/source variants not needed in VSIX
README_AZURE.md
README_BADGES_*.md
README_GITHUB.md
package_vsix.sh
node_modules/**
package-lock.json

# Preview images must be hosted on a public site.
# It's not useful to have them in the VSIX.
img/screencast_final_fallback.png
img/screencast_final.gif

obsolete/**
tools/**

# VCS / editor noise
.git/**
.gitignore
