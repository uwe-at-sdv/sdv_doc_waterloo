{
	"description": "Waterloo MCP auth token store JSON schema.",
	"x-published": "2026-07-07",
	"x-changelog": [
		{
			"version": "0.1.0",
			"date": "2026-07-07",
			"changes": [
				{
					"type": "meta",
					"summary": "Initial schema version."
				}
			]
		}
	],
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://sci-d-vis.com/schema/wtrl-mcp-auth-token-store-json-0.1.0.schema.json",
	"title": "Waterloo MCP auth token store JSON",
	"type": "object",
	"required": [
		"tokens"
	],
	"additionalProperties": false,
	"properties": {
		"tokens": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"token_sha256",
					"token_id",
					"user",
					"client",
					"location",
					"created_at",
					"expires_at",
					"revoked_at",
					"notes"
				],
				"additionalProperties": false,
				"properties": {
					"token_sha256": {
						"type": "string",
						"pattern": "^[0-9a-f]{64}$"
					},
					"token_id": {
						"type": "string",
						"minLength": 1
					},
					"user": {
						"type": "string",
						"minLength": 1
					},
					"client": {
						"type": "string",
						"minLength": 1
					},
					"location": {
						"type": "string",
						"minLength": 1
					},
					"created_at": {
						"type": "string",
						"format": "date-time"
					},
					"expires_at": {
						"type": ["string", "null"]
					},
					"revoked_at": {
						"type": ["string", "null"]
					},
					"notes": {
						"type": ["string", "null"]
					}
				}
			}
		}
	}
}
