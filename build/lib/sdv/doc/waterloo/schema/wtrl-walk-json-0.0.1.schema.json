{
	"description": "Waterloo walk JSON schema. Keep changelog in x-changelog and validate edits.",
	"x-published": "2026-05-16",
	"x-changelog": [
		{
			"version": "0.0.1",
			"date": "2026-05-16",
			"changes": [
				{
					"type": "meta",
					"summary": "Initial provisional schema for walk traversal results."
				}
			]
		}
	],
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://sci-d-vis.com/schema/wtrl-walk-json-0.0.1.schema.json",
	"title": "Waterloo walk JSON",
	"type": "object",
	"required": [
		"$schema",
		"$id",
		"__WTRL_VERSION__",
		"__WTRL_META__",
		"__WTRL_OBJECTS__"
	],
	"additionalProperties": false,
	"$defs": {
		"kind": {
			"type": "string",
			"enum": ["module", "class", "function", "method", "property", "variable", "constant", "type", "unknown"]
		},
		"scope": {
			"type": "string",
			"enum": ["public", "extension", "core", "unknown"]
		},
		"reason": {
			"type": "string",
			"enum": ["included", "no_doc", "invalid", "filtered", "ambiguous", "scope"]
		},
		"walk_entry": {
			"type": "object",
			"required": ["qualname", "kind", "scope", "file", "lineno", "included", "reason"],
			"additionalProperties": true,
			"properties": {
				"qualname": { "type": "string" },
				"kind": { "$ref": "#/$defs/kind" },
				"scope": { "$ref": "#/$defs/scope" },
				"file": { "type": ["string", "null"] },
				"lineno": { "type": ["integer", "null"] },
				"included": { "type": "boolean" },
				"reason": { "$ref": "#/$defs/reason" },
				"reason_detail": { "type": "string" }
			}
		},
		"count_map": {
			"type": "object",
			"additionalProperties": { "type": "integer" }
		}
	},
	"properties": {
		"$schema": { "type": "string" },
		"$id": { "type": "string" },
		"__WTRL_VERSION__": {
			"type": "object",
			"required": ["waterloo", "schema"],
			"additionalProperties": false,
			"properties": {
				"waterloo": { "type": "string" },
				"schema": { "type": "string" }
			}
		},
		"__WTRL_META__": {
			"type": "object",
			"required": ["generated_at", "generator", "basedir", "obj"],
			"additionalProperties": true,
			"properties": {
				"generated_at": { "type": "string", "format": "date-time" },
				"generator": { "type": "string" },
				"basedir": { "type": "string" },
				"obj": { "type": "string" },
				"include_imported": { "type": "boolean" },
				"show": {
					"type": "array",
					"items": { "type": "string" }
				}
			}
		},
		"__WTRL_SUMMARY__": {
			"type": "object",
			"additionalProperties": true,
			"properties": {
				"total": { "type": "integer" },
				"included": { "type": "integer" },
				"excluded": { "type": "integer" },
				"by_kind": { "$ref": "#/$defs/count_map" },
				"by_scope": { "$ref": "#/$defs/count_map" },
				"by_reason": { "$ref": "#/$defs/count_map" }
			}
		},
		"__WTRL_OBJECTS__": {
			"type": "array",
			"items": { "$ref": "#/$defs/walk_entry" }
		}
	}
}
