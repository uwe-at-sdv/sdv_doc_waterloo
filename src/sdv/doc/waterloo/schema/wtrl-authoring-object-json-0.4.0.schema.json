{
  "description": "Waterloo Authoring JSON for exactly one documentable object.",
  "x-published": "2026-09-30",
  "x-changelog": [
    {"version": "0.1.0", "date": "2026-09-12", "changes": [{"type": "meta", "summary": "Initial schema version."}]},
    {"version": "0.2.0", "date": "2026-09-24", "changes": [{"type": "feature", "summary": "Add keyed table blocks to free-form content."}]},
    {"version": "0.3.0", "date": "2026-09-28", "changes": [{"type": "fix", "summary": "Restrict Contract entries to the selected profile."}]},
    {"version": "0.4.0", "date": "2026-09-30", "changes": [{"type": "feature", "summary": "Allow Definitions._inherit as a list of inherited term identifiers."}]}
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sci-d-vis.com/schema/wtrl-authoring-object-json-0.4.0.schema.json",
  "title": "Waterloo Authoring JSON object",
  "type": "object",
  "required": ["$schema", "$id", "__WTRL_CATEGORY__", "__WTRL_VERSION__", "qualified_name", "profile", "doc"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "https://sci-d-vis.com/schema/wtrl-authoring-object-json-0.4.0.schema.json"},
    "$id": {"type": "string", "pattern": "^urn:waterlint:wtrl-authoring-object-json:[^\\s]+$"},
    "__WTRL_CATEGORY__": {"const": "wtrl-authoring-object-json"},
    "__WTRL_VERSION__": {
      "type": "object", "required": ["schema"], "additionalProperties": false,
      "properties": {"schema": {"const": "0.4.0"}}
    },
    "qualified_name": {"$ref": "#/$defs/qualified_identifier"},
    "profile": {"$ref": "#/$defs/profile"},
    "signature": {"$ref": "#/$defs/logical_text"},
    "doc": {"$ref": "#/$defs/doc"}
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "module"}}},
      "then": {"properties": {"doc": {"$ref": "#/$defs/module_doc"}}, "not": {"required": ["signature"]}}
    },
    {
      "if": {"properties": {"profile": {"const": "class"}}},
      "then": {"properties": {"doc": {"$ref": "#/$defs/class_doc"}}, "not": {"required": ["signature"]}}
    },
    {
      "if": {"properties": {"profile": {"const": "function"}}},
      "then": {"properties": {"doc": {"$ref": "#/$defs/function_doc"}}, "required": ["signature"]}
    },
    {
      "if": {"properties": {"profile": {"const": "method"}}},
      "then": {"properties": {"doc": {"$ref": "#/$defs/method_doc"}}, "required": ["signature"]}
    },
    {
      "if": {"properties": {"profile": {"const": "inherited_method"}}},
      "then": {"properties": {"doc": {"$ref": "#/$defs/inherited_method_doc"}}, "required": ["signature"]}
    }
  ],
  "$defs": {
    "profile": {"type": "string", "enum": ["module", "class", "function", "method", "inherited_method"]},
    "identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "qualified_identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
    "csv_identifiers": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*$"},
    "logical_text": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"},
    "paragraph_block": {
      "type": "object", "required": ["paragraph"], "additionalProperties": false,
      "properties": {"paragraph": {"$ref": "#/$defs/logical_text"}}
    },
    "list_item": {
      "type": "object", "required": ["text"], "additionalProperties": false,
      "properties": {
        "text": {"$ref": "#/$defs/logical_text"},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/list_item"}}
      }
    },
    "list_block": {
      "type": "object", "required": ["list"], "additionalProperties": false,
      "properties": {"list": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/list_item"}}}
    },
    "table_column": {
      "type": "object", "required": ["key", "header"], "additionalProperties": false,
      "properties": {"key": {"$ref": "#/$defs/identifier"}, "header": {"$ref": "#/$defs/logical_text"}}
    },
    "table_row": {
      "type": "object", "required": ["cells"], "additionalProperties": false,
      "properties": {"cells": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[^\\r\\n]*$"}}}
    },
    "table_group": {
      "type": "object", "required": ["columns", "rows"], "additionalProperties": false,
      "properties": {
        "title": {"type": "array", "items": {"$ref": "#/$defs/logical_text"}},
        "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/table_column"}},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/table_row"}}
      }
    },
    "table_block": {
      "type": "object", "required": ["table"], "additionalProperties": false,
      "properties": {
        "table": {
          "type": "object", "required": ["groups"], "additionalProperties": false,
          "properties": {"groups": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/table_group"}}}
        }
      }
    },
    "text_block": {
      "type": "object",
      "allOf": [
        {"if": {"required": ["paragraph"]}, "then": {"$ref": "#/$defs/paragraph_block"}},
        {"if": {"required": ["list"]}, "then": {"$ref": "#/$defs/list_block"}},
        {"if": {"required": ["table"]}, "then": {"$ref": "#/$defs/table_block"}}
      ],
      "oneOf": [
        {"required": ["paragraph"]},
        {"required": ["list"]},
        {"required": ["table"]}
      ]
    },
    "text_blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text_block"}},
    "contract_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/logical_text"}},
    "identifier_text_map": {
      "type": "object", "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/text_blocks"}
    },
    "qualified_identifier_text_map": {
      "type": "object", "propertyNames": {"$ref": "#/$defs/qualified_identifier"},
      "additionalProperties": {"$ref": "#/$defs/text_blocks"}
    },
    "free_label_text_map": {
      "type": "object", "propertyNames": {"$ref": "#/$defs/logical_text"},
      "additionalProperties": {"$ref": "#/$defs/text_blocks"}
    },
    "definition_map": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/csv_identifiers"},
      "properties": {"_inherit": {"$ref": "#/$defs/identifier_list"}},
      "additionalProperties": {"$ref": "#/$defs/text_blocks"}
    },
    "identifier_list": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}},
    "qualified_identifier_list": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/qualified_identifier"}},
    "preamble": {
      "type": "object", "required": ["profile", "normative_sections"], "additionalProperties": false,
      "properties": {
        "profile": {"$ref": "#/$defs/profile"},
        "normative_sections": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "status": {"type": "string", "enum": ["experimental", "stable", "frozen", "deprecated", "draft"]},
        "scope": {"type": "array", "items": {"type": "string", "enum": ["public", "extension", "core"]}}
      }
    },
    "contract": {
      "type": "object", "required": ["general"], "additionalProperties": false,
      "properties": {
        "general": {"$ref": "#/$defs/contract_items"},
        "constructor": {"$ref": "#/$defs/contract_items"},
        "base": {"$ref": "#/$defs/qualified_identifier"},
        "traits": {"type": "array", "items": {"type": "string", "enum": ["abstract", "final"]}},
        "invariants": {"$ref": "#/$defs/contract_items"},
        "requires": {"$ref": "#/$defs/contract_items"},
        "ensures": {"$ref": "#/$defs/contract_items"}
      }
    },
    "module_contract": {
      "type": "object", "required": ["general"], "additionalProperties": false,
      "properties": {"general": {"$ref": "#/$defs/contract_items"}}
    },
    "class_contract": {
      "type": "object", "required": ["general", "constructor"], "additionalProperties": false,
      "properties": {
        "general": {"$ref": "#/$defs/contract_items"},
        "constructor": {"$ref": "#/$defs/contract_items"},
        "traits": {"type": "array", "items": {"type": "string", "enum": ["abstract", "final"]}}
      }
    },
    "callable_contract": {
      "type": "object", "required": ["general"], "additionalProperties": false,
      "properties": {
        "general": {"$ref": "#/$defs/contract_items"},
        "invariants": {"$ref": "#/$defs/contract_items"},
        "requires": {"$ref": "#/$defs/contract_items"},
        "ensures": {"$ref": "#/$defs/contract_items"}
      }
    },
    "inherited_method_contract": {
      "type": "object", "required": ["general", "base"], "additionalProperties": false,
      "properties": {
        "general": {"$ref": "#/$defs/contract_items"},
        "base": {"$ref": "#/$defs/qualified_identifier"}
      }
    },
    "doc": {
      "type": "object", "required": ["Preamble", "Contract"], "additionalProperties": false,
      "properties": {
        "Preamble": {"$ref": "#/$defs/preamble"}, "Definitions": {"$ref": "#/$defs/definition_map"},
        "Terminology": {"$ref": "#/$defs/free_label_text_map"}, "Contract": {"$ref": "#/$defs/contract"},
        "Description": {"$ref": "#/$defs/text_blocks"}, "Derived_from": {"$ref": "#/$defs/qualified_identifier_list"},
        "Factory": {"$ref": "#/$defs/qualified_identifier_text_map"}, "Public_classes": {"$ref": "#/$defs/qualified_identifier_list"},
        "Class_overview": {"$ref": "#/$defs/identifier_text_map"}, "Public_functions": {"$ref": "#/$defs/qualified_identifier_list"},
        "Function_overview": {"$ref": "#/$defs/identifier_text_map"}, "Public_methods": {"$ref": "#/$defs/qualified_identifier_list"},
        "Method_overview": {"$ref": "#/$defs/identifier_text_map"}, "Public_types": {"$ref": "#/$defs/identifier_text_map"},
        "Public_variables": {"$ref": "#/$defs/identifier_text_map"}, "Public_constants": {"$ref": "#/$defs/identifier_text_map"},
        "Parameters": {"$ref": "#/$defs/identifier_text_map"}, "Returns": {"$ref": "#/$defs/text_blocks"},
        "Raises": {"$ref": "#/$defs/qualified_identifier_text_map"}, "Notes": {"$ref": "#/$defs/free_label_text_map"},
        "See_also": {"$ref": "#/$defs/qualified_identifier_list"}
      }
    },
    "module_doc": {
      "type": "object",
      "propertyNames": {"enum": ["Preamble", "Definitions", "Terminology", "Contract", "Description", "Public_classes", "Class_overview", "Public_functions", "Function_overview", "Public_types", "Public_variables", "Public_constants", "Notes", "See_also"]},
      "properties": {
        "Preamble": {"properties": {"profile": {"const": "module"}}},
        "Contract": {"$ref": "#/$defs/module_contract"},
        "Definitions": {"not": {"required": ["_inherit"]}}
      }
    },
    "class_doc": {
      "type": "object",
      "propertyNames": {"enum": ["Preamble", "Definitions", "Terminology", "Contract", "Description", "Derived_from", "Factory", "Public_classes", "Class_overview", "Public_methods", "Method_overview", "Public_types", "Public_variables", "Public_constants", "Notes", "See_also"]},
      "properties": {"Preamble": {"properties": {"profile": {"const": "class"}}}, "Contract": {"$ref": "#/$defs/class_contract"}}
    },
    "function_doc": {
      "type": "object",
      "required": ["Parameters", "Returns", "Raises"],
      "propertyNames": {"enum": ["Preamble", "Definitions", "Terminology", "Contract", "Description", "Parameters", "Returns", "Raises", "Notes", "See_also"]},
      "properties": {"Preamble": {"properties": {"profile": {"const": "function"}}}, "Contract": {"$ref": "#/$defs/callable_contract"}}
    },
    "method_doc": {
      "type": "object",
      "required": ["Parameters", "Returns", "Raises"],
      "propertyNames": {"enum": ["Preamble", "Definitions", "Terminology", "Contract", "Description", "Parameters", "Returns", "Raises", "Notes", "See_also"]},
      "properties": {"Preamble": {"properties": {"profile": {"const": "method"}}}, "Contract": {"$ref": "#/$defs/callable_contract"}}
    },
    "inherited_method_doc": {
      "type": "object",
      "propertyNames": {"enum": ["Preamble", "Definitions", "Terminology", "Contract", "Description", "Notes", "See_also"]},
      "properties": {"Preamble": {"properties": {"profile": {"const": "inherited_method"}}}, "Contract": {"$ref": "#/$defs/inherited_method_contract"}}
    }
  }
}
