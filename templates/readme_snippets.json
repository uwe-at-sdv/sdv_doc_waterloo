{
"$schema":"sdv_snippets.schema.json",
"$basedir":".",
"$write":{
	"path":"../README.md",
	"content":{
		"$replace":{
			"content":{
				"$switch":{
					"cond":{ "$opt":{ "arg":"--target" } },
					"cases":{
						"github":{ "$read":{ "path":"README_GITHUB.template.md" } },
						"pypi":{ "$read":{ "path":"README_PYPI.template.md" } }
						}
					}
				},
			"rules":{
				"_LOGO_":{
					"$switch":{
						"cond":{ "$opt":{ "arg":"--target" } },
						"cases":{
							"github":{ "$read":{ "path":"README_LOGO_GITHUB.template.md" } },
							"pypi":{ "$read":{ "path":"README_LOGO_PYPI.template.md" } }
							}
						}
					},
				"_BADGES_":{
					"$replace":{
						"content":{
							"$switch":{
								"cond":{ "$opt":{ "arg":"--target" } },
								"cases":{
									"github":{ "$read":{ "path":"README_BADGES_GITHUB.template.md" } },
									"pypi":{ "$read":{ "path":"README_BADGES_PYPI.template.md" } }
									}
								}
							},
						"rules":{
							"_COMMON_":{
								"$read":{ "path":"README_BADGES_COMMON.template.md" }
								}
							}
						}
					},
				"_INSTALL_":{
					"$switch":{
						"cond":{ "$opt":{ "arg":"--target" } },
						"cases":{
							"github":{ "$read":{ "path":"README_INSTALL_GITHUB.template.md" } },
							"pypi":{ "$read":{ "path":"README_INSTALL_PYPI.template.md" } }
							}
						}
					},
				"_COMMON_":{
					"$replace":{
						"content":{ "$read":{ "path":"README_COMMON.template.md" } },
						"rules":{
							"_MCP_CONFIG_":{
								"$switch":{
									"cond":{ "$opt":{ "arg":"--target" } },
									"cases":{
										"github":{ "$read":{ "path":"README_MCP_CONFIG_GITHUB.template.md" } },
										"pypi":{ "$read":{ "path":"README_MCP_CONFIG_PYPI.template.md" } }
										}
									}
								}
							}
						}
					},
				"_SITEMAP_":{
					"$read":{ "path":"README_SITEMAP_GITHUB.template.md" }
					}
				}
			}
		}
	}
}
