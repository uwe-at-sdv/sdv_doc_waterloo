{
	"description": "Waterloo JSON diagnostics schema. Keep changelog in x-changelog and validate edits.",
	"x-published": "2026-02-17",
	"x-changelog": [
		{
			"version": "0.0.1",
			"date": "2026-02-19",
			"changes": [
				{
					"type": "meta",
					"summary": "Initial version."
				}
			]
		}
	],
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://sci-d-vis.com/schema/wtrl-tracer-json-0.0.1.schema.json",
	"title": "Waterloo JSON diagnostics (schema 0.0.1, provisional)",
	"type": "object",
	"required": [
		"$schema",
		"$id",
		"__WTRL_VERSION__",
		"__WTRL_INFO__",
		"__WTRL_WARNING__",
		"__WTRL_ERROR__"
	],
	"additionalProperties": false,

	"$defs": {

		"origin": {
			"type": "string",
			"enum": ["parsing", "validation", "tool"]
		},

		"rule-id": {
			"type": "string",
			"pattern": "^[A-Z]{3,8}-[0-9]{3,4}$"
		},

		"context": {
			"type": "array",
			"items": { "type": "string" }
		},

		"entry_base": {
			"type": "object",
			"required": ["kind", "origin", "msg"],
			"additionalProperties": false,
			"properties": {
				"kind": { "type": "string" },
				"origin": { "$ref": "#/$defs/origin" },
				"context": { "$ref": "#/$defs/context" },
				"msg": { "type": "string" }
			}
		},

		"entry_debug": {
			"allOf": [
				{ "$ref": "#/$defs/entry_base" },
				{
					"properties": {
						"kind": { "const": "debug" }
					}
				}
			]
		},

		"entry_info": {
			"allOf": [
				{ "$ref": "#/$defs/entry_base" },
				{
					"properties": {
						"kind": { "const": "info" }
					}
				}
			]
		},

		"entry_warning": {
			"allOf": [
				{ "$ref": "#/$defs/entry_base" },
				{
					"required": ["rule-id"],
					"properties": {
						"kind": { "const": "warning" },
						"rule-id": { "$ref": "#/$defs/rule-id" }
					}
				}
			]
		},

		"entry_error": {
			"allOf": [
				{ "$ref": "#/$defs/entry_base" },
				{
					"required": ["rule-id"],
					"properties": {
						"kind": { "const": "error" },
						"rule-id": { "$ref": "#/$defs/rule-id" }
					}
				}
			]
		}
	},

	"properties": {

		"$schema": { "type": "string" },
		"$id": { "type": "string" },

		"__WTRL_VERSION__": {
			"type": "object",
			"required": ["waterloo", "schema"],
			"additionalProperties": false,
			"properties": {
				"waterloo": { "type": "string" },
				"schema": { "type": "string" }
			}
		},

		"__WTRL_DEBUG__": {
			"type": "array",
			"items": { "$ref": "#/$defs/entry_debug" }
		},

		"__WTRL_INFO__": {
			"type": "array",
			"items": { "$ref": "#/$defs/entry_info" }
		},

		"__WTRL_WARNING__": {
			"type": "array",
			"items": { "$ref": "#/$defs/entry_warning" }
		},

		"__WTRL_ERROR__": {
			"type": "array",
			"items": { "$ref": "#/$defs/entry_error" }
		}
	}
}
