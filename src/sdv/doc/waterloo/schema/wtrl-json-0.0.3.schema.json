{
	"$comment": "On this version:",
	"$comment": "* We still only validate down to but no including",
	"$comment": "  the `doc` section. `doc` is governed by the normative",
	"$comment": "  rules of Waterloo Docstrings as given in the human-readable",
	"$comment": "  documentation in branch package_gh-pages.",
	"$comment": "* More regular naming scheme for keys.",
	"$comment": "Style guide:",
	"$comment": "* Indentation unit is one TAB.",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://sci-d-vis.com/schema/wtrl-json-0.0.3.schema.json",
	"title": "Waterloo JSON export (schema 0.0.3, provisional)",
	"type": "object",
	"required": [
		"$schema",
		"$id",
		"__WTRL_VERSION__",
		"__WTRL_META__",
		"__WTRL_ROLES__",
		"__WTRL_OBJECTS__"
	],
	"additionalProperties": false,
	"properties": {
		"$schema": {"type": "string" },
		"$id": {"type": "string" },
		"__WTRL_VERSION__": {
			"type": "object",
			"required": ["waterloo", "schema"],
			"additionalProperties": false,
			"properties": {
				"waterloo": { "type": "string" },
				"schema": { "type": "string" }
			}
		},

		"__WTRL_META__":{
			"type": "object",
			"required": ["generated_at","generator","scope","flavour"],
			"additionalProperties": false,
			"properties": {
				"generated_at": { "type": "string", "format": "date-time" },
				"generator": { "type": "string" },
				"scope": { "type": "string" },
				"flavour": { "type": "string" }
			}
		},

		"__WTRL_ROLES__": {
			"type": "object",
			"$comment": "Role entries look like e.g. 'attr':'Attribute name': label and human/LLM-readable explanation",
			"additionalProperties": { "type": "string" }
		},

		"__WTRL_TOC_MODULES__": { "$ref": "#/$defs/toc_map" },
		"__WTRL_TOC_CLASSES__": { "$ref": "#/$defs/toc_map" },
		"__WTRL_TOC_CALLABLES__": { "$ref": "#/$defs/toc_map" },
		"__WTRL_TOC_TYPES__": { "$ref": "#/$defs/toc_map" },
		"__WTRL_TOC_VARIABLES__": { "$ref": "#/$defs/toc_map" },
		"__WTRL_TOC_CONSTANTS__": { "$ref": "#/$defs/toc_map" },

		"__WTRL_OBJECTS__": {
			"type": "object",
			"minProperties": 0,
			"additionalProperties": { "$ref": "#/$defs/wtrl_object" }
		}
	},

	"$defs": {
		"identifier": {
			"type": "string",
			"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
		},
		"qualified_identifier": {
			"type": "string",
			"pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
		},
		"json_pointer": {
			"type": "string",
			"pattern": "^(#)?(/([^~]|~[01])*)*$"
		},

		"toc_map": {
			"type": "object",
			"additionalProperties": { "$ref": "#/$defs/json_pointer" }
		},
		"list_of_identifiers": {
			"type": "array",
			"minItems": 0,
			"items": { "$ref": "#/$defs/identifier" }
		},
		"list_of_strings": {
			"type": "array",
			"minItems": 0,
			"items": { "type": "string" }
		},

		"wtrl_object": {
			"type": "object",
			"required": ["doc"],
			"properties": {
				"path": {
					"$comment":"Built-in modules have no path, so null must be allowed:",
					"type": ["string","null"]
				},
				"signature": { "$ref": "#/$defs/signature" },
				"decorators": {
					 "$comment": "This is an array of strings representing the decorators of a callable.",
					 "$ref": "#/$defs/list_of_strings"
				},
				"traits": {
					 "$comment": "This is an array of identifiers like e.g.'coroutine', 'generator'.",
					 "$ref": "#/$defs/list_of_identifiers"
				},
				"doc": {
					"oneOf": [
					 {
						 "type": "object",
						 "minProperties": 0,
						 "additionalProperties": true
					 },
					 {
						 "type": "array",
						 "items": { "type": ["string", "number", "boolean", "null", "object", "array"] }
					 },
					 { "type": ["string", "null"] }
					]
			 	}
			},
			"additionalProperties": true
		},

		"signature": {
			"type": "object",
			"required": ["text", "parameters", "returns"],
			"properties": {
				"text": { "type": "string" },
				"parameters": {
					"type": "array",
					"items": { "$ref": "#/$defs/parameter" }
				},
				"returns": {
					"type": ["string", "null"]
				}
			},
			"additionalProperties": true
		},

		"parameter": {
			"type": "object",
			"required": ["name", "kind", "annotation", "default"],
			"properties": {
				"name": { "type": "string" },
				"kind": { "type": "string" },
				"annotation": { "type": ["string", "null"] },
				"default": { "type": ["string", "number", "boolean", "null", "object", "array"] }
			},
			"additionalProperties": true
		}
	}
}
