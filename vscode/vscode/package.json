{
	"name": "waterloo-docstrings",
	"displayName": "Waterloo Docstrings",
	"description": "Tools for Waterloo docstrings in Python.",
	"version": "0.1.0",
	"publisher": "local",
	"engines": {
		"vscode": "^1.80.0"
	},
	"main": "./extension.js", 
	"activationEvents": [
		"onCommand:waterloo.generateMinimalDocstring",
		"onCommand:waterloo.testMenu",
		"onLanguage:python"
	],
	"categories": [
		"Programming Languages"
	],
	"scripts": {
		"use:stable": "python3 ./tools/select_grammar.py stable",
		"use:experimental": "python3 ./tools/select_grammar.py experimental"
	},
	"contributes": {
		"grammars": [
			{
				"scopeName": "waterloo.injection",
				"path": "./syntaxes/waterloo.injection.tmLanguage.json",
				"injectTo": [
					"source.python"
				]
			}
		],
			"commands": [
				{
					"command": "waterloo.generateMinimalDocstring",
					"title": "Waterloo: Generate Minimal Docstring"
				},
				{
					"command": "waterloo.testMenu",
					"title": "Waterloo: Test Menu Item"
				}
			],
		"submenus": [
			{
				"id": "waterloo.context",
				"label": "Waterloo"
			}
		],
		"menus": {
				"editor/context": [
					{
						"submenu": "waterloo.context",
						"group": "navigation@50",
						"when": "resourceLangId == python && editorTextFocus && waterloo.isFuncClassOrModuleLine"
					}
				],
						"waterloo.context": [
							{
								"command": "waterloo.generateMinimalDocstring",
								"group": "1_generate@10",
								"when": "resourceLangId == python && editorTextFocus && waterloo.isFuncClassOrModuleLine"
						},
						{
							"command": "waterloo.testMenu",
						"group": "9_test@10",
						"when": "resourceLangId == python && editorTextFocus && waterloo.isFuncClassOrModuleLine"
					}
				]
			},
		"keybindings": [
				{
					"command": "waterloo.testMenu",
					"key": "ctrl+alt+w",
					"when": "resourceLangId == python && editorTextFocus && waterloo.isFuncClassOrModuleLine"
				}
			]
	}
}
