        "mod",
        "norm",
        "op",
        "opt",
        "ref",
        "term",
        "type",
        "value",
        "tag",
        "var",
        "var_type"
      ]
    },
    {
      "kind": "role-examples",
      "items": [
        "|attr|`kind`",
        "|cmd|`waterlint validate` |opt|`--basedir` |file|`package/sdv/app/clql` |opt|`--obj` |value|`clql.Message`",
        "|dfn|`SomeTermDefinedHere`",
        "|file|`package_main/doc/source/format.rst`",
        "|func|`my_function` ( |value|`arg1`, |value|`arg2` )",
        "|key|`CTRL-C`",
        "|label|`Contract.general`",
        "|lit|`root`",
        "|lit|`stdout`",
        "|mod|`sdv.doc.waterloo.docitem_helper`",
        "|norm|`Must`",
        "|op|`+`",
        "|opt|`--out-diag-json`",
        "|ref|`Label wtrl://some.ref`",
        "|ref|`Label https://link.org`",
        "|tag|`section`",
        "|tag|`table`",
        "|term|`SomeTermReferenced`",
        "|type|`int`",
        "|type|`mcp.myclass`",
        "|value|`42`",
        "|value|`some string`",
        "|var|`myvar`",
        "|var_type|`myvar:float`"
      ]
    },
    {
      "kind": "rules",
      "items": [
        "Do not use normativity keywords, value tokens, or role markup in labels or identifier lists.",
        "Use normativity keywords, value tokens, and role markup in free-form or itemized text only.",
        "Use normativity keywords only in normative sections and subsections.",
        "Use proper capitalization, e.g. |Must| at the beginning of a sentence and |must| within a sentence.",
        "Use |attr| for JSON keys, XML attributes, and similar constructs.",
        "Use |label| when referring to labels, titles or captions in documents.",
        "Use |tag| for tag names without angle brackets when output layers add the brackets later."
      ]
    }
  ]
}
