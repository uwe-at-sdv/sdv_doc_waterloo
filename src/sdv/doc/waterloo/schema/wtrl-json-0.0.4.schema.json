{
	"description": "Waterloo JSON export schema. Keep changelog metadata in x-changelog and validate edits (for example with jsonlint-php).",
	"x-published": "2026-02-17",
	"x-changelog": [
		"0.0.4: In non-aggregate categories (Types, Variables, Constants) use doc_lines for plain line arrays to simplify filtering.",
		"0.0.4: In non-aggregate categories, 'doc' is deprecated. Will be forbidden at 0.1.0.",
		"0.0.4: Machine-readable metadata in schema (x-changelog, x-published).",
		"0.0.3: Validate structural envelope; detailed doc subtree semantics are governed by the normative Waterloo docstring rules.",
		"0.0.3: More regular naming scheme for keys."
	],
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://sci-d-vis.com/schema/wtrl-json-0.0.4.schema.json",
	"title": "Waterloo JSON export (schema 0.0.4, provisional)",
	"type": "object",
	"required": [
		"$schema",
		"$id",
		"__WTRL_VERSION__",
		"__WTRL_META__",
		"__WTRL_ROLES__",
		"__WTRL_OBJECTS__"
	],
	"additionalProperties": false,
	"properties": {
		"$schema": {"type": "string" },
		"$id": {"type": "string" },
		"__WTRL_VERSION__": {
			"type": "object",
			"required": ["waterloo", "schema"],
			"additionalProperties": false,
			"properties": {
				"waterloo": { "type": "string" },
				"schema": { "type": "string" }
			}
		},

		"__WTRL_META__":{
			"type": "object",
			"required": ["generated_at","generator","scope","flavour"],
			"additionalProperties": false,
			"properties": {
				"generated_at": { "type": "string", "format": "date-time" },
				"generator": { "type": "string" },
				"scope": { "type": "string" },
				"flavour": { "type": "string" }
			}
		},

		"__WTRL_ROLES__": {
			"type": "object",
			"$comment": "Role entries look like e.g. 'attr':'Attribute name': label and human/LLM-readable explanation",
			"additionalProperties": { "type": "string" }
		},

		"__WTRL_TOC_MODULES__": { "$ref": "#/$defs/toc_map" },
		"__WTRL_TOC_CLASSES__": { "$ref": "#/$defs/toc_map" },
		"__WTRL_TOC_CALLABLES__": { "$ref": "#/$defs/toc_map" },
		"__WTRL_TOC_TYPES__": { "$ref": "#/$defs/toc_map" },
		"__WTRL_TOC_VARIABLES__": { "$ref": "#/$defs/toc_map" },
		"__WTRL_TOC_CONSTANTS__": { "$ref": "#/$defs/toc_map" },

		"__WTRL_OBJECTS__": {
			"type": "object",
			"minProperties": 0,
			"additionalProperties": { "$ref": "#/$defs/wtrl_object" }
		}
	},

	"$defs": {
		"identifier": {
			"type": "string",
			"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
		},
		"qualified_identifier": {
			"type": "string",
			"pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
		},
		"json_pointer": {
			"type": "string",
			"pattern": "^(#)?(/([^~]|~[01])*)*$"
		},

		"toc_map": {
			"type": "object",
			"additionalProperties": { "$ref": "#/$defs/json_pointer" }
		},
		"list_of_identifiers": {
			"type": "array",
			"minItems": 0,
			"items": { "$ref": "#/$defs/identifier" }
		},
		"list_of_strings": {
			"type": "array",
			"minItems": 0,
			"items": { "type": "string" }
		},

		"wtrl_object": {
			"anyOf": [
				{
					"type": "object",
					"required": ["doc"],
					"properties": {
						"path": { "type": ["string", "null"] },
						"signature": { "$ref": "#/$defs/signature" },
						"decorators": { "$ref": "#/$defs/list_of_strings" },
						"traits": { "$ref": "#/$defs/list_of_identifiers" },
						"doc": {
							"type": "object",
							"minProperties": 0,
							"additionalProperties": true
						}
					},
					"additionalProperties": true
				},
				{
					"type": "object",
					"required": ["doc_lines"],
					"properties": {
						"doc_lines": { "$ref": "#/$defs/list_of_strings" },
						"doc": {
							"type": "object",
							"minProperties": 0,
							"additionalProperties": true,
							"deprecated": true
						}
					},
					"additionalProperties": true
				}
			]
		},

		"signature": {
			"type": "object",
			"required": ["text", "parameters", "returns"],
			"properties": {
				"text": { "type": "string" },
				"parameters": {
					"type": "array",
					"items": { "$ref": "#/$defs/parameter" }
				},
				"returns": {
					"type": ["string", "null"]
				}
			},
			"additionalProperties": true
		},

		"parameter": {
			"type": "object",
			"required": ["name", "kind", "annotation", "default"],
			"properties": {
				"name": { "type": "string" },
				"kind": { "type": "string" },
				"annotation": { "type": ["string", "null"] },
				"default": { "type": ["string", "number", "boolean", "null", "object", "array"] }
			},
			"additionalProperties": true
		}
	}
}
