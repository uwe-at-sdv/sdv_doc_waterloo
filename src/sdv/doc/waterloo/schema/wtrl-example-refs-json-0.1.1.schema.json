{
    "description": "Waterloo example-refs mapping for waterlint add-example-json.",
    "x-published": "2026-04-17",
    "x-changelog": [
        {
            "version": "0.1.1",
            "date": "2026-04-17",
            "changes": [
                {
                    "type": "meta",
                    "summary": "Initial schema version."
                }
            ]
        }
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://sci-d-vis.com/schema/wtrl-example-refs-json-0.1.0.schema.json",
    "title": "Waterloo example refs mapping (schema 0.1.0, provisional)",
    "type": "object",
    "required": [
        "$schema",
        "$id",
        "__WTRL_VERSION__",
        "__WTRL_EXAMPLE_REFS__"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "format": "uri-reference"
        },
        "$id": {
            "type": "string",
            "format": "uri-reference"
        },
        "__WTRL_VERSION__": {
            "type": "object",
            "required": [
                "waterloo",
                "waterlint_min",
                "schema"
            ],
            "additionalProperties": false,
            "properties": {
                "waterloo": {
                    "type": "string"
                },
                "waterlint_min": {
                    "type": "string"
                },
                "schema": {
                    "type": "string"
                }
            }
        },
        "__WTRL_EXAMPLE_REFS__": {
            "type": "object",
            "patternProperties": {
                "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "$defs": {
        "qualified_identifier": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        }
    }
}
