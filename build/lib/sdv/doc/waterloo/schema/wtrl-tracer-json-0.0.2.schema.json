{
	"description": "Waterloo JSON diagnostics schema. Keep changelog in x-changelog and validate edits.",
	"x-published": "2026-02-17",
	"x-changelog": [
		{
			"version": "0.0.1",
			"date": "2026-02-19",
			"changes": [
				{
					"type": "meta",
					"summary": "Initial version."
				}
			]
		},
		{
			"version": "0.0.2",
			"date": "2026-02-19",
			"changes": [
				{
					"type": "meta",
					"summary": "Added optional details for machine-readable diagnostics, including JSON-schema paths."
				}
			]
		}
	],
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://sci-d-vis.com/schema/wtrl-tracer-json-0.0.2.schema.json",
	"title": "Waterloo JSON diagnostics (schema 0.0.2, provisional)",
	"type": "object",
	"required": [
		"$schema",
		"$id",
		"__WTRL_VERSION__",
		"__WTRL_INFO__",
		"__WTRL_WARNING__",
		"__WTRL_ERROR__"
	],
	"additionalProperties": false,
	"$defs": {
		"origin": {
			"type": "string",
			"enum": ["parsing", "validation", "tool"]
		},
		"rule-id": {
			"type": "string",
			"pattern": "^[A-Z]{3,8}-[0-9]{3,4}$"
		},
		"context": {
			"type": "array",
			"items": { "type": "string" }
		},
		"path_tokens": {
			"type": "array",
			"items": {
				"oneOf": [
					{ "type": "string" },
					{ "type": "integer" }
				]
			}
		},
		"details": {
			"type": "object",
			"additionalProperties": true,
			"properties": {
				"validator": { "type": "string" },
				"path": { "$ref": "#/$defs/path_tokens" },
				"schema_path": { "$ref": "#/$defs/path_tokens" },
				"path_pointer": { "type": "string" },
				"schema_path_pointer": { "type": "string" }
			}
		},
		"entry_debug": {
			"type": "object",
			"required": ["kind", "origin", "msg"],
			"additionalProperties": false,
			"properties": {
				"kind": { "type": "string", "const": "debug" },
				"origin": { "$ref": "#/$defs/origin" },
				"context": { "$ref": "#/$defs/context" },
				"msg": { "type": "string" },
				"details": { "$ref": "#/$defs/details" }
			}
		},
		"entry_info": {
			"type": "object",
			"required": ["kind", "origin", "msg"],
			"additionalProperties": false,
			"properties": {
				"kind": { "type": "string", "const": "info" },
				"origin": { "$ref": "#/$defs/origin" },
				"context": { "$ref": "#/$defs/context" },
				"msg": { "type": "string" },
				"details": { "$ref": "#/$defs/details" }
			}
		},
		"entry_warning": {
			"type": "object",
			"required": ["kind", "origin", "rule-id", "msg"],
			"additionalProperties": false,
			"properties": {
				"kind": { "type": "string", "const": "warning" },
				"origin": { "$ref": "#/$defs/origin" },
				"rule-id": { "$ref": "#/$defs/rule-id" },
				"context": { "$ref": "#/$defs/context" },
				"msg": { "type": "string" },
				"details": { "$ref": "#/$defs/details" }
			}
		},
		"entry_error": {
			"type": "object",
			"required": ["kind", "origin", "rule-id", "msg"],
			"additionalProperties": false,
			"properties": {
				"kind": { "type": "string", "const": "error" },
				"origin": { "$ref": "#/$defs/origin" },
				"rule-id": { "$ref": "#/$defs/rule-id" },
				"context": { "$ref": "#/$defs/context" },
				"msg": { "type": "string" },
				"details": { "$ref": "#/$defs/details" }
			}
		}
	},
	"properties": {
		"$schema": { "type": "string" },
		"$id": { "type": "string" },
		"__WTRL_VERSION__": {
			"type": "object",
			"required": ["waterloo", "schema"],
			"additionalProperties": false,
			"properties": {
				"waterloo": { "type": "string" },
				"schema": { "type": "string" }
			}
		},
		"__WTRL_DEBUG__": {
			"type": "array",
			"items": { "$ref": "#/$defs/entry_debug" }
		},
		"__WTRL_INFO__": {
			"type": "array",
			"items": { "$ref": "#/$defs/entry_info" }
		},
		"__WTRL_WARNING__": {
			"type": "array",
			"items": { "$ref": "#/$defs/entry_warning" }
		},
		"__WTRL_ERROR__": {
			"type": "array",
			"items": { "$ref": "#/$defs/entry_error" }
		}
	}
}
