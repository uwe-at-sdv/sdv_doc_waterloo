{
  "description": "Waterloo JSON export schema. Keep changelog in x-changelog and validate edits (for example with jsonlint-php).",
  "x-published": "2026-09-26",
  "x-changelog": [
    {
      "version": "0.3.0",
      "date": "2026-09-26",
      "changes": [
        {
          "type": "change",
          "summary": "Add optional doc_blocks for structured documentation of standalone Public_types, Public_variables, and Public_constants members."
        }
      ]
    },
    {
      "version": "0.2.0",
      "date": "2026-09-21",
      "changes": [
        {
          "type": "change",
          "summary": "Allow structured table blocks in table-capable docstring content."
        }
      ]
    },
    {
      "version": "0.1.0",
      "date": "2026-03-05",
      "changes": [
        {
          "type": "change",
          "summary": "Add optional __WTRL_SCOPES__ legend section with scope value/description entries."
        },
        {
          "type": "change",
          "summary": "Allow optional __WTRL_EXAMPLES__ and object-level examples pointers."
        }
      ]
    },
    {
      "version": "0.0.4",
      "date": "2026-02-17",
      "changes": [
        {
          "type": "change",
          "summary": "Use doc_lines for plain line arrays to simplify filtering."
        },
        {
          "type": "deprecation",
          "summary": "'doc' is deprecated; will be forbidden in 0.1.0."
        },
        {
          "type": "meta",
          "summary": "Add machine-readable metadata in schema (x-changelog, x-published)."
        }
      ]
    },
    {
      "version": "0.0.3",
      "date": "2026-02-16",
      "changes": [
        {
          "type": "change",
          "summary": "Validate structural envelope; doc subtree semantics follow normative rules."
        },
        {
          "type": "change",
          "summary": "More regular naming scheme for keys."
        }
      ]
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sci-d-vis.com/schema/wtrl-json-0.3.0.schema.json",
  "title": "Waterloo JSON export (schema 0.3.0, provisional)",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "__WTRL_VERSION__",
    "__WTRL_META__",
    "__WTRL_ROLES__",
    "__WTRL_OBJECTS__"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$id": { "type": "string" },
    "__WTRL_VERSION__": {
      "type": "object",
      "required": ["waterloo", "schema"],
      "additionalProperties": false,
      "properties": {
        "waterloo": { "type": "string" },
        "schema": { "const": "0.3.0" }
      }
    },
    "__WTRL_META__": {
      "type": "object",
      "required": ["generated_at", "generator", "scope", "flavour"],
      "additionalProperties": false,
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "generator": { "type": "string" },
        "scope": { "type": "string" },
        "flavour": { "type": "string" }
      }
    },
    "__WTRL_ROLES__": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "__WTRL_SCOPES__": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/scope_entry" }
    },
    "__WTRL_TOC_MODULES__": { "$ref": "#/$defs/toc_map" },
    "__WTRL_TOC_CLASSES__": { "$ref": "#/$defs/toc_map" },
    "__WTRL_TOC_CALLABLES__": { "$ref": "#/$defs/toc_map" },
    "__WTRL_TOC_TYPES__": { "$ref": "#/$defs/toc_map" },
    "__WTRL_TOC_VARIABLES__": { "$ref": "#/$defs/toc_map" },
    "__WTRL_TOC_CONSTANTS__": { "$ref": "#/$defs/toc_map" },
    "__WTRL_EXAMPLES__": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": { "$ref": "#/$defs/wtrl_example" }
    },
    "__WTRL_OBJECTS__": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": { "$ref": "#/$defs/wtrl_object" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "qualified_identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "json_pointer": {
      "type": "string",
      "pattern": "^(#)?(/([^~]|~[01])*)*$"
    },
    "json_pointer_to_example": {
      "type": "string",
      "pattern": "^/__WTRL_EXAMPLES__/[A-Za-z0-9_\\-\\.]+$"
    },
    "toc_map": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/json_pointer" }
    },
    "list_of_identifiers": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "list_of_strings": {
      "type": "array",
      "minItems": 0,
      "items": { "type": "string" }
    },
    "scope_entry": {
      "type": "object",
      "required": ["value", "description"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "integer" },
        "description": { "type": "string" }
      }
    },
    "table_row": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "table_group": {
      "type": "object",
      "required": ["header", "rows"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/list_of_strings" },
        "header": { "$ref": "#/$defs/table_row" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/table_row" }
        }
      }
    },
    "table": {
      "type": "object",
      "required": ["groups"],
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/table_group" }
        }
      }
    },
    "table_block": {
      "type": "object",
      "required": ["table"],
      "additionalProperties": false,
      "properties": {
        "table": { "$ref": "#/$defs/table" }
      }
    },
    "content_block": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/table_block" }
      ]
    },
    "content_blocks": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/content_block" }
    },
    "signature": {
      "type": "object",
      "required": ["text", "parameters", "returns"],
      "additionalProperties": true,
      "properties": {
        "text": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "returns": { "type": ["string", "null"] }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["name", "kind", "annotation", "default"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "annotation": { "type": ["string", "null"] },
        "default": { "type": ["string", "number", "boolean", "null", "object", "array"] }
      }
    },
    "wtrl_example": {
      "type": "object",
      "required": ["lang", "hash", "code", "referenced_by"],
      "additionalProperties": true,
      "properties": {
        "lang": { "type": "string" },
        "path": { "type": "string" },
        "hash": { "type": "string" },
        "code": { "type": "string" },
        "referenced_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualified_identifier" }
        }
      }
    },
    "wtrl_doc_definition_entry_new": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "variations": { "$ref": "#/$defs/list_of_identifiers" },
        "text": { "$ref": "#/$defs/content_blocks" }
      }
    },
    "wtrl_doc_definition_entry": {
      "oneOf": [
        { "$ref": "#/$defs/content_blocks" },
        { "$ref": "#/$defs/wtrl_doc_definition_entry_new" }
      ]
    },
    "wtrl_doc_definitions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/wtrl_doc_definition_entry" }
    },
    "wtrl_doc_named_content_blocks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/content_blocks" }
    },
    "wtrl_doc": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": true,
      "properties": {
        "Definitions": { "$ref": "#/$defs/wtrl_doc_definitions" },
        "Terminology": { "$ref": "#/$defs/wtrl_doc_named_content_blocks" },
        "Description": { "$ref": "#/$defs/content_blocks" },
        "Returns": { "$ref": "#/$defs/content_blocks" },
        "Notes": { "$ref": "#/$defs/wtrl_doc_named_content_blocks" }
      }
    },
    "wtrl_object": {
      "anyOf": [
        {
          "type": "object",
          "required": ["doc"],
          "additionalProperties": true,
          "properties": {
            "path": { "type": ["string", "null"] },
            "signature": { "$ref": "#/$defs/signature" },
            "decorators": { "$ref": "#/$defs/list_of_strings" },
            "traits": { "$ref": "#/$defs/list_of_identifiers" },
            "examples": {
              "type": "array",
              "items": { "$ref": "#/$defs/json_pointer_to_example" }
            },
            "doc": { "$ref": "#/$defs/wtrl_doc" },
            "doc_blocks": { "$ref": "#/$defs/content_blocks" }
          }
        },
        {
          "type": "object",
          "required": ["doc_lines"],
          "additionalProperties": true,
          "properties": {
            "doc_lines": { "$ref": "#/$defs/list_of_strings" },
            "doc_blocks": { "$ref": "#/$defs/content_blocks" },
            "examples": {
              "type": "array",
              "items": { "$ref": "#/$defs/json_pointer_to_example" }
            },
            "doc": {
              "type": "object",
              "minProperties": 0,
              "additionalProperties": true,
              "deprecated": true
            }
          }
        }
      ]
    }
  }
}
